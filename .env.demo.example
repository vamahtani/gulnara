# Operator-only demo. Copy to .env.demo; never put tokens or API keys here.
DEMO_AZURE_SUBSCRIPTION_ID=your-approved-subscription-id
AZURE_OPENAI_ENDPOINT=https://your-approved-account.openai.azure.com/
AZURE_OPENAI_DEPLOYMENT=text-embedding-3-small
DEMO_SQL_SERVER=your-approved-server.database.windows.net
DEMO_OPENAI_RESOURCE_GROUP=your-approved-openai-resource-group
# Existing Azure CLI Entra sign-in is used for AI and cloud SQL.
# --auth api-key explicitly selects approved Azure CLI key retrieval into memory.
# It never reads a key from this file or changes the cloud SQL Entra credential.
# The local target uses only this app's existing private SQL container.
# The CLI accepts appdb, gulnara_db or gulnara_db_demo only; select your own approved target.
DEMO_SQL_DATABASE=REPLACE_APPROVED_DATABASE_NAME
